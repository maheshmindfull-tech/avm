# AVM Environment Configuration
# Copy this file to .env and fill in your values

# Google Apps Script Web App URL (deployed URL for lead submission)
# This is the publicly deployed URL of your Google Apps Script web app.
# See README.md for setup instructions.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Site URL (used for SEO canonical URLs and sitemap)
VITE_SITE_URL=https://avm.example.com
